server {

    # Replace with your domain name if you have one, otherwise use your EC2 IP
    server_name mohamedessa.dev www.mohamedessa.dev mecodes.live www.mecodes.live;

    # Document root - where your React build files will be
    root /var/www/mecodes.live;
    index index.html index.htm;

    # Logging
    access_log /var/log/nginx/mecodes.live.access.log;
    error_log /var/log/nginx/mecodes.live.error.log;

    # Handle React Router (Single Page Application)
    # This is crucial for React apps with client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        alias /var/www/mecodes.live/assets/;
    }

    # Cache static assets for better performance
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;

    # Gzip compression for better performance
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mecodes.live/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mecodes.live/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot








}
server {
    if ($host = www.mohamedessa.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = mohamedessa.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = mecodes.live) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = www.mecodes.live) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name mohamedessa.dev www.mohamedessa.dev mecodes.live www.mecodes.liv;
    return 404; # managed by Certbot
}